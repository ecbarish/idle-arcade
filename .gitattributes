# Line endings: the repo stores every text file with LF endings, whichever computer or assistant commits it
# (Evan's Windows PCs, ChatGPT/Codex and Claude's Linux sandboxes). Godot and the browsers read LF everywhere.
* text=auto eol=lf

# Windows-only scripts keep CRLF when checked out.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touched by line-ending conversion or text diffs.
*.png binary
*.jpg binary
*.ogg binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.ttf binary
*.woff2 binary
*.pck binary
*.wasm binary
*.zip binary
